# Copy this file to .env (cp .env.example .env). Inspect reads .env
# automatically when you run `inspect` from this folder (or any folder below
# it). Settings here act as default CLI options.

# Default model when you don't pass --model. mockllm/model is a free fake
# model built into Inspect, so every script runs without an API key.
INSPECT_EVAL_MODEL=mockllm/model

# Where eval logs are written. `inspect view` reads from here too.
INSPECT_LOG_DIR=./logs

# To use a real model, add its API key below (the anthropic and openai
# packages are already installed). .env is gitignored, so keys stay local.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
